# Both empty: demo mode. Set both for a dedicated LUMA project; partial config fails closed.
# Public project identifiers only. Never add secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical trusted origin for verification/recovery emails and upload CSRF checks.
SITE_URL=http://localhost:3000
# Server-side limit; defaults to 6 MiB, maximum 20 MiB (bucket ceiling).
MAX_UPLOAD_BYTES=6291456
# Optional safe output directory if generated Windows files cannot be cleaned.
# LUMA_DIST_DIR=.next-verify-local
